# Copy this file to `.env` and fill in the two values from your Supabase project
# (Dashboard -> Project Settings -> Data API).
#
#   cp .env.example .env
#
# `.env` is gitignored. Never commit it.

# ---------------------------------------------------------------------------
# SAFE TO EXPOSE IN THE BROWSER
#
# Everything prefixed with VITE_ is compiled into the JavaScript bundle that ships
# to GitHub Pages. Anyone can read these two values by opening devtools. That is
# how Supabase is designed to be used from a browser, and it is safe *because*
# Row Level Security decides what any given request may see.
#
# The anon key gets a request as far as the database. The policies in
# supabase/migrations decide what comes back — for an unauthenticated caller,
# nothing at all.
# ---------------------------------------------------------------------------

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# ---------------------------------------------------------------------------
# NEVER PUT THESE HERE, OR ANYWHERE UNDER src/
#
#   - the service_role key   (bypasses RLS completely — full read/write on every
#                             table for anyone who finds it)
#   - the database password
#   - the JWT secret
#   - any Supabase access token or personal token
#
# A VITE_-prefixed variable is not a secret. If you ever need a privileged key, it
# belongs in a Supabase Edge Function or another server-side context — never in
# this file and never in the frontend.
#
# Run the admin SQL (supabase/bootstrap.sql, supabase/seed.sql) in the Supabase
# dashboard's SQL editor, which is already authenticated. The app never needs a
# privileged key.
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# WEB PUSH (optional)
#
# Generate a key pair once with:  npm run vapid
#
# This is the PUBLIC half. It is compiled into the bundle and is meant to be
# visible — it is the key browsers encrypt their push payloads to.
#
# Leave it unset and the app works normally, just without push notifications.
# ---------------------------------------------------------------------------

VITE_VAPID_PUBLIC_KEY=

# The PRIVATE half must NEVER appear in this file or in any VITE_ variable.
# It goes only into Supabase Edge Function secrets:
#
#   supabase secrets set VAPID_PRIVATE_KEY=... VAPID_PUBLIC_KEY=... VAPID_SUBJECT=mailto:you@example.com
#
# Anyone holding the private key can send push notifications to your users.
